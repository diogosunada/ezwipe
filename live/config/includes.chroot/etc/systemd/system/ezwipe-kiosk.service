[Unit]
Description=EZWipe full-screen interface on tty1
After=systemd-user-sessions.service ezwipe-data.service systemd-udev-settle.service
Wants=ezwipe-data.service
Conflicts=getty@tty1.service
# Crash-loop guard: after 10 failed starts in 5 minutes, stop and show the console.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
ExecStart=/usr/local/bin/ezwipe-session
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
